<?xml version="1.0" encoding="utf-8"?>
<!-- Programme console qui utilise le réseau : la permission INTERNET place le processus dans
     le groupe inet d'Android, sans lequel socket() échoue (EACCES). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.anyandroid.samples.net"
    android:versionCode="1"
    android:versionName="1.0">
  <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <application android:label="Net demo"/>
</manifest>
